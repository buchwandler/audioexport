+    assert passed["cover"] == explicit_cover
+    assert (passed["bitrate"], passed["sample_rate"], passed["channels"]) == ("128k", 48000, 1)
+
+    profile_result = export_book(workspace, variant=VARIANT, profile=profile_path, force=True)
